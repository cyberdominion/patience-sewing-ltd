generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts, sessions, wholesale access
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  RETAILER
  CUSTOMER
}

enum RetailerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  retailerProfile RetailerProfile?
  orders      Order[]
  addresses   Address[]
  leads       Lead[]            @relation("LeadOwner")
  followUps   FollowUp[]
activities LeadActivity[]
  crmNotes   CrmNote[]
  reviews    Review[]

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("Home")
  line1      String
  city       String
  state      String   @default("Bayelsa")
  country    String   @default("Nigeria")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RetailerProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  businessName       String
  businessType       String         @default("Boutique")
  registrationNumber String?
  taxId              String?
  shopAddress        String
  city               String
  state              String         @default("Bayelsa")
  yearsInBusiness    Int?
  monthlyVolume      String?
  productCategories  String[]
  status             RetailerStatus @default(PENDING)
  discountPercent    Int            @default(20)
  creditLimit        Int            @default(0)
  reviewedBy         String?
  reviewNote         String?
  reviewedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application RetailerApplication? @relation(fields: [applicationId], references: [id])
  applicationId String? @unique
  orders     Order[]

  @@index([status])
}

model RetailerApplication {
  id           String         @id @default(cuid())
  email        String
  fullName     String
  phone        String
  businessName String
  businessType String
  shopAddress  String
  city         String
  state        String         @default("Bayelsa")
  yearsInBusiness Int?
  monthlyVolume   String?
  categories   String[]
  note         String?
  status       RetailerStatus @default(PENDING)
  reviewedBy   String?
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  profile RetailerProfile?

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Category {
  DRESSES
  TWO_PIECE
  THREE_PIECE
  CAPSULES
  OUTERWEAR
  ACCESSORIES
  CUSTOM_BESPOKE
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  subtitle    String?
  description String
  category    Category
  fabric      String?
  colourways  String[]
  sizes       String[]
  styleCode   String?
  bespoke     Boolean       @default(false)

  // Prices stored in kobo (NGN minor units) so money is never a float.
  retailPrice       Int
  wholesalePrice    Int
  wholesaleMinQty   Int            @default(6)
  compareAtPrice    Int?

  stock          Int            @default(0)
  lowStockAlert   Int            @default(5)
  leadTimeDays    Int            @default(14)

  images      ProductImage[]
  status      ProductStatus  @default(DRAFT)
  featured    Boolean        @default(false)
  tags        String[]
  seoTitle    String?
  seoDescription String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems OrderItem[]
  reviews    Review[]

  @@index([status, category])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentChannel {
  PAYSTACK_CARD
  PAYSTACK_BANK
  PAYSTACK_USSD
  PAYSTACK_QR
  PAYSTACK_TRANSFER
  BANK_TRANSFER
  COD
}

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  userId      String?
  retailerId  String?
  status      OrderStatus @default(PENDING)

  subtotalRetail     Int @default(0)
  subtotalWholesale  Int @default(0)
  discountAmount     Int @default(0)
  deliveryFee        Int @default(0)
  totalAmount        Int @default(0)

  pricingTier    String    @default("RETAIL")
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingLine1   String?
  shippingCity    String?
  shippingState   String?
  shippingCountry String    @default("Nigeria")
  deliveryNotes   String?
  isCustomBespoke Boolean   @default(false)
  measurements    Json?
  designBrief     String?

  paystackReference    String?   @unique
  paystackAccessCode   String?
  paystackChannel      PaymentChannel?
  amountPaid           Int       @default(0)
  paidAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  retailer   RetailerProfile? @relation(fields: [retailerId], references: [id], onDelete: SetNull)
  items      OrderItem[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String?
  name       String
  slug       String
  imageUrl   String?
  size       String?
  colourway  String?
  quantity   Int
  unitPrice  Int
  lineTotal  Int
  tier       String @default("RETAIL")
  notes      String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  authorName String
  rating    Int
  title     String?
  body      String
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// CRM: acquisition, retention, AI-assisted follow-ups
// ---------------------------------------------------------------------------

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEBSITE
  REFERRAL
  WALK_IN
  MARKET
  PAYMENT_LINK
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum FollowUpChannel {
  WHATSAPP
  PHONE
  EMAIL
  SMS
  IN_PERSON
}

enum FollowUpStatus {
  PENDING
  SENT
  REPLIED
  NO_RESPONSE
  RESCHEDULED
  CANCELLED
}

model Lead {
  id        String @id @default(cuid())
  fullName  String
  email     String?
  phone     String
  city      String?
  state     String @default("Bayelsa")
  source    LeadSource @default(WEBSITE)
  stage     LeadStage   @default(NEW)

  interestedIn String?
  budgetRange  String?
  timeline     String?
  orderValueEstimate Int   @default(0)

  notes      String?
  tags       String[]
  score      Int     @default(0)
  ownerId    String?
  convertedUserId String?
  lostReason String?

  lastContactedAt DateTime?
  nextFollowUpAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  followUps FollowUp[]
  activities LeadActivity[]
  notesLog  CrmNote[]

  @@index([stage])
  @@index([source])
  @@index([phone])
  @@index([nextFollowUpAt])
}

model FollowUp {
  id        String @id @default(cuid())
  leadId    String
  userId    String?
  channel   FollowUpChannel @default(WHATSAPP)
  status    FollowUpStatus  @default(PENDING)

  scheduledAt DateTime
  sentAt      DateTime?
  outcome     String?
  outcomeScore Int?

  // AI assisted copy
  aiSummary        String?
  aiSuggestedMessage String?
  aiTone           String?
  aiModel          String?
  aiEditedMessage  String?
  aiAcceptedAt     DateTime?
  aiRejectedAt     DateTime?

  // The copy the salesperson actually sends, after any edits.
  finalMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([leadId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  actorId   String?
  type      String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([createdAt])
}

model CrmNote {
  id        String   @id @default(cuid())
  leadId    String?
  userId    String?
  body      String
  createdAt DateTime @default(now())
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Site
// ---------------------------------------------------------------------------

model SiteSettings {
  id              String @id @default("singleton")
  businessName    String @default("Patience Sewing Ltd")
  tagline         String @default("Bespoke Nigerian fashion, stitched to measure")
  whatsappNumber  String @default("2348000000000")
  supportEmail    String @default("hello@patiencesewing.com")
  supportPhone    String @default("+2348000000000")
  instagramHandle String?
  facebookUrl     String?
  tiktokHandle    String?
  deliveryFee     Int    @default(150000)
  freeDeliveryThreshold Int @default(2000000)
  bankName        String?
  bankAccountNumber String?
  bankAccountName String?
  aiModel         String @default("gpt-4o-mini")
  aiEnabled       Boolean @default(true)
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  source      LeadSource @default(WEBSITE)
  targetUrl   String   @default("/")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  isActive    Boolean  @default(true)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clicksLog   CampaignClick[]

  @@index([slug])
  @@index([source])
  @@index([isActive])
}

model CampaignClick {
  id        String   @id @default(cuid())
  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  ip        String?
  userAgent String?
  leadId    String?
  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String?
  message   String
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())
}
